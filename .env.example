# App Environment
APP_ENV=production
JWT_SECRET=your_super_secret_production_key_here

# LLM Provider Configuration
# Supported providers: openai, groq, ollama
LLM_PROVIDER=groq
MODEL_NAME=qwen/qwen3.6-27b

# API Keys
OPENAI_API_KEY="your_openai_api_key"
GROQ_API_KEY=
OLLAMA_BASE_URL="http://host.docker.internal:11434" # Or update to a proper deployed Ollama URL

# Search & Tools
TAVILY_API_KEY=

# Infrastructure (Docker Compose internal network)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/deepsearch"
REDIS_URL="redis://redis:6379/0"
QDRANT_URL="http://qdrant:6333"

# Langfuse Observability (Optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
